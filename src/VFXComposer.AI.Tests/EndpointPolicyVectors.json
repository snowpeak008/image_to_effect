{
  "formatVersion": 1,
  "vectors": [
    {
      "name": "https-canonical",
      "uri": "https://provider.example.invalid/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": true,
      "canonicalUri": "https://provider.example.invalid/v1/"
    },
    {
      "name": "https-case-canonicalizes",
      "uri": "HTTPS://PROVIDER.EXAMPLE.INVALID/v1",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": true,
      "canonicalUri": "https://provider.example.invalid/v1"
    },
    {
      "name": "userinfo-rejected",
      "uri": "https://user:password@provider.example.invalid/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": false
    },
    {
      "name": "query-rejected",
      "uri": "https://provider.example.invalid/v1/?api_key=not-a-service-root",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": false
    },
    {
      "name": "fragment-rejected",
      "uri": "https://provider.example.invalid/v1/#fragment",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": false
    },
    {
      "name": "length-2048-accepted",
      "uri": "https://provider.example.",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": true,
      "canonicalUri": "https://provider.example."
    },
    {
      "name": "length-2049-rejected",
      "uri": "https://provider.example.",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": false
    },
    {
      "name": "https-development-is-allowed",
      "uri": "https://provider.example.invalid/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "DevelopmentOnly",
      "expected": true,
      "canonicalUri": "https://provider.example.invalid/v1/"
    },
    {
      "name": "https-loopback-flag-rejected",
      "uri": "https://provider.example.invalid/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "DevelopmentOnly",
      "expected": false
    },
    {
      "name": "http-localhost-development",
      "uri": "http://localhost:8787/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "DevelopmentOnly",
      "expected": true,
      "canonicalUri": "http://localhost:8787/v1/"
    },
    {
      "name": "http-127-development",
      "uri": "http://127.0.0.1:8787/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "DevelopmentOnly",
      "expected": true,
      "canonicalUri": "http://127.0.0.1:8787/v1/"
    },
    {
      "name": "http-ipv6-loopback-development",
      "uri": "http://[::1]:8787/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "DevelopmentOnly",
      "expected": true,
      "canonicalUri": "http://[::1]:8787/v1/"
    },
    {
      "name": "http-loopback-production-rejected",
      "uri": "http://localhost:8787/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "Production",
      "expected": false
    },
    {
      "name": "http-public-ipv4-rejected",
      "uri": "http://198.51.100.24/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "DevelopmentOnly",
      "expected": false
    },
    {
      "name": "http-public-ipv6-rejected",
      "uri": "http://[2001:db8::24]/v1/",
      "allowLoopbackHttp": true,
      "secretScope": "DevelopmentOnly",
      "expected": false
    },
    {
      "name": "https-public-ipv4",
      "uri": "https://198.51.100.24/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": true,
      "canonicalUri": "https://198.51.100.24/v1/"
    },
    {
      "name": "https-public-ipv6",
      "uri": "https://[2001:db8::24]/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": true,
      "canonicalUri": "https://[2001:db8::24]/v1/"
    },
    {
      "name": "raw-unicode-idn-rejected",
      "uri": "https://bücher.example/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": false
    },
    {
      "name": "punycode-idn-canonical",
      "uri": "https://XN--BCHER-KVA.EXAMPLE/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": true,
      "canonicalUri": "https://xn--bcher-kva.example/v1/"
    },
    {
      "name": "non-http-scheme-rejected",
      "uri": "ftp://provider.example.invalid/v1/",
      "allowLoopbackHttp": false,
      "secretScope": "Production",
      "expected": false
    }
  ]
}
