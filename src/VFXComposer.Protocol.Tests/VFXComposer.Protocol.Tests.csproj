<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VFXComposer.Protocol.Tests</AssemblyName>
    <RootNamespace>VFXComposer.Protocol.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VFXComposer.Protocol\VFXComposer.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\schemas\desktop\**\*.schema.json"
          Link="Schemas\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="GoldenVectors\**\*.json"
          Link="GoldenVectors\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\protocol-vectors\desktop-phase2-worker-handle-lifecycle-v1.json"
          Link="GoldenVectors\desktop-phase2-worker-handle-lifecycle-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
