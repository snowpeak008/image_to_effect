<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VFXComposer.BuildHost</AssemblyName>
    <RootNamespace>VFXComposer.BuildHost</RootNamespace>
    <IsPackable>false</IsPackable>
