<Window
    x:Class="VFXComposer.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VFXComposer.Desktop.ViewModels"
    xmlns:views="using:VFXComposer.Desktop.Views"
    x:DataType="vm:MainWindowViewModel"
    Title="VFX Composer"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="600">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#20242B" />
      <Setter Property="BorderBrush" Value="#343A45" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#AAB2BF" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}" x:DataType="vm:DashboardViewModel">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}" x:DataType="vm:LibraryViewModel">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CreateViewModel}" x:DataType="vm:CreateViewModel">
      <views:CreateView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PreviewViewModel}" x:DataType="vm:PreviewViewModel">
      <views:PreviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PatchViewModel}" x:DataType="vm:PatchViewModel">
      <views:PatchView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReviewViewModel}" x:DataType="vm:ReviewViewModel">
      <views:ReviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:JobsViewModel}" x:DataType="vm:JobsViewModel">
      <views:JobsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}" x:DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*" Background="#15181D">
    <Border Grid.ColumnSpan="2" Padding="20,14" Background="#1B1F25" BorderBrush="#343A45" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ProductName}" VerticalAlignment="Center" />
        <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="#3A2528">
          <TextBlock Foreground="#FFB3B8" Text="{Binding ConnectionDisplay}" />
        </Border>
        <Border Grid.Column="2" Padding="10,5" CornerRadius="12" Background="#292E36">
          <TextBlock Foreground="#C6CEDA" Text="{Binding ProjectDisplay}" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="12" Background="#1B1F25" BorderBrush="#343A45" BorderThickness="0,0,1,0">
      <ListBox
          ItemsSource="{Binding NavigationItems}"
          SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
          Background="Transparent"
          BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationItemViewModel">
            <TextBlock Margin="8,7" Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <ContentControl Margin="28" Content="{Binding CurrentPage}" />
    </ScrollViewer>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16,9" Background="#1B1F25" BorderBrush="#343A45" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel>
          <TextBlock Classes="muted" Text="Read-only ordinary-user session; commands and mutation are disabled" />
          <TextBlock Classes="muted" Text="{Binding SessionDisplay}" />
          <TextBlock Classes="muted" Text="{Binding ReadDisplay}" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding ConnectCommand}" Content="Connect" />
        <Button Grid.Column="2" Command="{Binding SelectProjectCommand}" Content="Select project" />
        <Button Grid.Column="3" Command="{Binding ReadProjectCommand}" Content="Read" />
        <Button Grid.Column="4" Command="{Binding RecoverCommand}" Content="Restart" />
      </Grid>
    </Border>
  </Grid>
</Window>
