<UserControl
    x:Class="VFXComposer.Desktop.Views.ReviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VFXComposer.Desktop.ViewModels"
    x:DataType="vm:ReviewViewModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="5">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding MachineStatus}" />
        <TextBlock Text="{Binding VisualStatus}" />
        <TextBlock Text="{Binding UserVerdictStatus}" />
        <TextBlock Text="{Binding L3Status}" />
        <TextBlock Text="{Binding L4Status}" />
      </StackPanel>
    </Border>
    <Border Classes="card" Background="#302A20">
      <TextBlock Foreground="#F1D39A" Text="{Binding AuthorityNotice}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
