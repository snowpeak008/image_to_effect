<UserControl
    x:Class="VFXComposer.Desktop.Views.PreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VFXComposer.Desktop.ViewModels"
    x:DataType="vm:PreviewViewModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="5">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[PreviewImageGenerationHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[PreviewImageGenerationNotice]}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="90" TextWrapping="Wrap" Watermark="{Binding Localization[PreviewImagePromptWatermark]}" Text="{Binding ImagePrompt}" />
        <Grid ColumnDefinitions="Auto,110,Auto,110,*" ColumnSpacing="8">
          <TextBlock VerticalAlignment="Center" Text="{Binding Localization[PreviewWidthLabel]}" />
          <TextBox Grid.Column="1" Text="{Binding ImageWidth}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Localization[PreviewHeightLabel]}" />
          <TextBox Grid.Column="3" Text="{Binding ImageHeight}" />
          <Button Grid.Column="4" HorizontalAlignment="Left" Command="{Binding GenerateImageCommand}" Content="{Binding Localization[PreviewGenerateImageAction]}" />
        </Grid>
        <TextBlock Classes="muted" Text="{Binding ImageStatus}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Classes="card" MinHeight="240">
      <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
    </Border>
  </StackPanel>
</UserControl>
