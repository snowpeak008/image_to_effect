<UserControl
    x:Class="VFXComposer.Desktop.Views.CreateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VFXComposer.Desktop.ViewModels"
    x:DataType="vm:CreateViewModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="5">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="Recipe draft" />
        <TextBox Watermark="Recipe name" Text="{Binding RecipeName}" />
        <TextBox AcceptsReturn="True" Height="140" TextWrapping="Wrap" Watermark="Draft notes" Text="{Binding DraftNotes}" />
        <TextBlock Classes="muted" Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="Chat" />
        <TextBlock Classes="muted" Text="This sends one explicit ChatLlm prompt through the configured binding." TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="96" TextWrapping="Wrap" Watermark="Ask the selected chat provider" Text="{Binding ChatPrompt}" />
        <Button HorizontalAlignment="Left" Command="{Binding SendChatCommand}" Content="Send chat prompt" />
        <TextBlock Classes="muted" Text="{Binding ChatStatus}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="140" IsReadOnly="True" Text="{Binding ChatResponse}" TextWrapping="Wrap" Watermark="Typed chat response appears here" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
