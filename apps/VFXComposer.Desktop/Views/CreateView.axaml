<UserControl
    x:Class="VFXComposer.Desktop.Views.CreateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VFXComposer.Desktop.ViewModels"
    x:DataType="vm:CreateViewModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="5">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateRecipeDraftHeading]}" />
        <TextBox Watermark="{Binding Localization[CreateRecipeNameWatermark]}" Text="{Binding RecipeName}" />
        <TextBox AcceptsReturn="True" Height="140" TextWrapping="Wrap" Watermark="{Binding Localization[CreateDraftNotesWatermark]}" Text="{Binding DraftNotes}" />
        <TextBlock Classes="muted" Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateSimpleModeHeading]}" />
        <TextBlock Classes="muted" Text="{Binding CapabilityLine}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding ScopeNotice}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding PresetCards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetCardViewModel">
              <Border Margin="0,3,8,3" Padding="10" Width="220" BorderBrush="#343A45" BorderThickness="1" CornerRadius="5">
                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                  <Button HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:CreateViewModel)DataContext).ApplyPresetCommand}"
                          CommandParameter="{Binding}"
                          Content="{Binding $parent[UserControl].((vm:CreateViewModel)DataContext).Localization[CreatePresetApplyAction]}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateSuggestionsHeading]}" />
        <ItemsControl ItemsSource="{Binding SuggestionSentences}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Margin="0,2" HorizontalAlignment="Left"
                      Command="{Binding $parent[UserControl].((vm:CreateViewModel)DataContext).UseSuggestionCommand}"
                      CommandParameter="{Binding}"
                      Content="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateGenerateRecipeHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateGenerateRecipeNotice]}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="96" TextWrapping="Wrap" Watermark="{Binding Localization[CreateEffectDescriptionWatermark]}" Text="{Binding EffectDescription}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding GenerateRecipeCommand}" Content="{Binding Localization[CreateGenerateDraftAction]}" />
          <Button Command="{Binding CancelGenerateRecipeCommand}" Content="{Binding Localization[CreateCancelGenerationAction]}" />
          <Button Command="{Binding ConfirmRecipeDraftCommand}" Content="{Binding Localization[CreateConfirmDraftAction]}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding RecipeStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" IsVisible="{Binding HasRetentionNotice}" Text="{Binding RecipeRetentionNotice}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="72" IsReadOnly="True" Text="{Binding RecipeValidationSummary}" TextWrapping="Wrap" Watermark="{Binding Localization[CreateValidationWatermark]}" />
        <TextBox AcceptsReturn="True" Height="180" IsReadOnly="True" FontFamily="Consolas,Menlo,monospace" Text="{Binding RecipeDraftJson}" TextWrapping="Wrap" Watermark="{Binding Localization[CreateDraftJsonWatermark]}" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding IsParameterPanelVisible}">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateParameterPanelHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateParameterPanelNotice]}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding ParameterPanel.Modules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ParameterModuleViewModel">
              <StackPanel Margin="0,4" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding Header}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Parameters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ParameterRowViewModel">
                      <Grid ColumnDefinitions="120,110,150,*" Margin="0,2">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Name}" />
                        <TextBox Grid.Column="1" Text="{Binding EditText}" />
                        <TextBlock Grid.Column="2" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ValueHint}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="3" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding BoundsHint}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontWeight="SemiBold" IsVisible="{Binding ParameterPanel.HasWarnings}" Text="{Binding Localization[CreateParameterWarningsHeading]}" />
        <ItemsControl ItemsSource="{Binding ParameterPanel.Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ParameterWarningViewModel">
              <TextBlock Classes="muted" Text="{Binding Text}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Left" Command="{Binding ApplyParameterEditsCommand}" Content="{Binding Localization[CreateParameterApplyAction]}" />
        <TextBox AcceptsReturn="True" Height="72" IsReadOnly="True" Text="{Binding ParameterPanel.IssueReport}" TextWrapping="Wrap" Watermark="{Binding Localization[CreateParameterReportWatermark]}" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding IsLineageVisible}">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateLineageHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateLineageNotice]}" TextWrapping="Wrap" />
        <TextBlock Foreground="#E39A9A" IsVisible="{Binding Lineage.HasListFailure}" Text="{Binding Lineage.ListFailure}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Lineage.Versions}" SelectedItem="{Binding Lineage.SelectedVersion, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LineageVersionViewModel">
              <StackPanel Margin="0,2" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Text="{Binding VersionLabel}" />
                  <!-- Origin and status are protocol words (REQ-004 §7.2 closed sets) and stay untranslated. -->
                  <TextBlock Classes="muted" Text="{Binding Origin}" />
                  <TextBlock Classes="muted" Text="{Binding Status}" />
                  <TextBlock FontWeight="SemiBold" Foreground="#9AE3B0" IsVisible="{Binding IsHead}" Text="{Binding HeadMarker}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="muted" Text="{Binding CreatedLine}" />
                  <TextBlock Classes="muted" Text="{Binding GuardLine}" />
                </StackPanel>
                <TextBlock Classes="muted" IsVisible="{Binding HasFeedback}" Text="{Binding FeedbackLine}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button HorizontalAlignment="Left" Command="{Binding RevertToSelectedVersionCommand}" Content="{Binding Localization[CreateLineageRevertAction]}" />
        <Border Background="#3A3320" BorderBrush="#F1D39A" BorderThickness="1" CornerRadius="5" Padding="10" IsVisible="{Binding Lineage.IsRevertPending}">
          <StackPanel Spacing="8">
            <TextBlock Foreground="#F1D39A" Text="{Binding Lineage.RevertPrompt}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ConfirmRevertCommand}" Content="{Binding Localization[CreateLineageConfirmRevertAction]}" />
              <Button Command="{Binding CancelRevertCommand}" Content="{Binding Localization[CreateLineageCancelRevertAction]}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding IsRefineVisible}">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateRefineHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateRefineNotice]}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="72" TextWrapping="Wrap" Watermark="{Binding Localization[CreateRefineFeedbackWatermark]}" Text="{Binding RefineFeedback}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding RefineRecipeCommand}" Content="{Binding Localization[CreateRefineAction]}" />
          <Button Command="{Binding CancelRefineRecipeCommand}" Content="{Binding Localization[CreateRefineCancelAction]}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding RefineStatus}" TextWrapping="Wrap" />
        <Border Background="#20303A" BorderBrush="#9AC4E3" BorderThickness="1" CornerRadius="5" Padding="10" IsVisible="{Binding HasGuardRestorations}">
          <StackPanel Spacing="4">
            <TextBlock Foreground="#9AC4E3" FontWeight="SemiBold" Text="{Binding GuardRestorationsHeading}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding GuardRestorationsReport}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding IsTimelineVisible}">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateTimelineHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateTimelineNotice]}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Timeline.Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionTimelineEntryViewModel">
              <TextBlock Classes="muted" Margin="0,2" Text="{Binding Text}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateBuildHandoffHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateBuildHandoffNotice]}" TextWrapping="Wrap" />
        <TextBox IsReadOnly="True" FontFamily="Consolas,Menlo,monospace" Text="{Binding BuildCommandLine}" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[CreateChatHeading]}" />
        <TextBlock Classes="muted" Text="{Binding Localization[CreateChatNotice]}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="96" TextWrapping="Wrap" Watermark="{Binding Localization[CreateChatPromptWatermark]}" Text="{Binding ChatPrompt}" />
        <Button HorizontalAlignment="Left" Command="{Binding SendChatCommand}" Content="{Binding Localization[CreateSendChatAction]}" />
        <TextBlock Classes="muted" Text="{Binding ChatStatus}" TextWrapping="Wrap" />
        <TextBox AcceptsReturn="True" Height="140" IsReadOnly="True" Text="{Binding ChatResponse}" TextWrapping="Wrap" Watermark="{Binding Localization[CreateChatResponseWatermark]}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
