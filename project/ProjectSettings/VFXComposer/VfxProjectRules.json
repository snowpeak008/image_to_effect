{
  "schemaVersion": 1,
  "rulesVersion": "1.0-draft",
  "defaultEnforcement": "strict",
  "legacyEffectIds": [],
  "simple": {
    "maxGameObjects": 10,
    "maxDepth": 3,
    "maxLocalMaterials": 6,
    "maxLocalTextures": 3
  },
  "complex": {
    "maxGameObjects": 16,
    "maxDepth": 3,
    "maxLocalMaterials": 2,
    "maxLocalTextures": 3
  },
  "archetypeProfiles": {
    "projectile": "simple",
    "impact": "simple",
    "slash": "simple",
    "aura": "simple",
    "area": "complex",
    "beam": "simple",
    "trail": "simple",
    "shield": "simple",
    "spawn": "complex",
    "summon": "complex",
    "transform": "complex",
    "environment": "complex",
    "screen_ui": "simple",
    "status": "simple",
    "composite": "complex",
    "decal": "simple",
    "weapon_trail": "simple",
    "destruction": "complex",
    "lifecycle": "complex",
    "portal": "complex",
    "loot": "simple"
  },
  "forbiddenRuntimeComponentTypeNames": [
    "GalleryController"
  ],
  "forbiddenProductionNameTokens": [
    "final_final",
    " copy",
    "_copy"
  ],
  "allowedDependencyRoots": [
    "Assets/VFX/Generated/",
    "Assets/VFX/Shared/",
    "Assets/VFX/TechniqueFamilies/",
    "Packages/com.vfxcomposer.unity/Runtime/",
    "Packages/com.unity.render-pipelines.core/",
    "Packages/com.unity.render-pipelines.universal/",
    "Packages/com.unity.ugui/"
  ]
}
