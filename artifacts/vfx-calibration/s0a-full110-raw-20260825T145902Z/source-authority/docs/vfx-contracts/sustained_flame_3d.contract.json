  "allowedSubstitutions": [
    {
      "substitutionId": "allow_noise_implementation",
      "from": "procedural turbulence described by this contract",
      "to": "an equivalent deterministic procedural noise function",
      "rationale": "noise implementation may change while preserving independent turbulent motion and the same evidence gates"
    },
    {
      "substitutionId": "allow_light_api",
      "from": "one UnityEngine.Light point light",
      "to": "one platform-equivalent project-approved real light adapter",
      "rationale": "future platforms may use an adapter, but additive sprite brightness remains forbidden"
    }
  ],
  "forbiddenSubstitutions": [
    {
      "substitutionId": "forbid_full_image_loop",
      "from": "independently simulated flame layers",
      "to": "a whole rendered flame picture rotating, scaling, or looping as one card",
      "rationale": "whole-image motion does not implement sustained combustion semantics"
    },
    {
      "substitutionId": "forbid_fake_light",
      "from": "actual point light and receiver luminance change",
      "to": "additive glow or bloom with no receiver lighting",
      "rationale": "self-bright pixels are not scene illumination"
    },
    {
      "substitutionId": "forbid_hard_stop",
      "from": "bounded graceful stop or distinct interrupt",
      "to": "instant disabling of every layer for both exits",
      "rationale": "stop and interrupt are separate semantic exits"
    },
    {
      "substitutionId": "forbid_single_layer",
      "from": "independent core, outer flame, smoke, embers and light",
      "to": "one carrier that visually bakes all required layers together",
      "rationale": "required layers need independent telemetry, tuning and cleanup"
    },
    {
      "substitutionId": "forbid_runtime_png",
      "from": "zero-texture procedural baseline",
      "to": "a runtime PNG, flipbook, or copied full flame image",
      "rationale": "S0b intentionally validates the minimal procedural carrier and its size budget"
    }
