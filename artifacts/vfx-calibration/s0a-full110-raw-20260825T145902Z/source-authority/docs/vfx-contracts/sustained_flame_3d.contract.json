  "requirements": [
    {
      "designRequirementId": "REQ-LIFECYCLE-START",
      "type": "behavioral",
      "evidenceAuthority": "telemetry",
      "statement": "PlayWithSeed enters starting once and reaches steady within 0.35 seconds unless explicitly stopped or interrupted."
    },
    {
      "designRequirementId": "REQ-LIFECYCLE-STEADY",
      "type": "behavioral",
      "evidenceAuthority": "telemetry",
      "statement": "Steady combustion remains active for at least three observable statistical cycles and has no implicit duration limit."
    },
    {
      "designRequirementId": "REQ-LIFECYCLE-STOP",
      "type": "behavioral",
      "evidenceAuthority": "telemetry",
      "statement": "Stop ends emission, preserves only the bounded stop tail, disables light on time, and returns to idle by the cleanup deadline."
    },
    {
      "designRequirementId": "REQ-LIFECYCLE-INTERRUPT",
      "type": "behavioral",
      "evidenceAuthority": "telemetry",
      "statement": "Interrupt uses a distinct burst exit and returns to idle by the cleanup deadline."
    },
    {
      "designRequirementId": "REQ-LAYERS-INDEPENDENT",
      "type": "structural",
      "evidenceAuthority": "telemetry",
      "statement": "Core flame, outer flame, smoke, embers, exits, and light are independently addressable carriers with deterministic seeds where applicable."
    },
    {
      "designRequirementId": "REQ-LIGHT-REAL",
      "type": "structural",
      "evidenceAuthority": "telemetry",
      "statement": "Exactly one enabled-at-runtime UnityEngine.Light exists, has no shadows, and stays within the declared intensity and range budget."
    },
    {
      "designRequirementId": "REQ-LIGHT-RECEIVER",
      "type": "visual-measurable",
      "evidenceAuthority": "diagnostic",
      "statement": "With simulation frozen, toggling only the point light causes a measurable positive linear-luminance delta on the separate receiver outside the effect mask.",
      "visualVerdict": {
        "subject": "Preview_LightReceiver",
        "expectedCondition": "receiver linear luminance with light on exceeds the matched light-off capture",
        "evidenceLocation": {"state": "steady", "frameInterval": [60, 180], "roi": "receiver-only mask excluding the flame silhouette"}
      }
    },
    {
      "designRequirementId": "REQ-VISUAL-STEADY",
      "type": "visual-semantic",
      "evidenceAuthority": "visualQa",
      "statement": "The steady state reads as one continuous flame with a hot core, subordinate outer flame, sparse smoke, and independently detached embers rather than a rotating whole image.",
      "visualVerdict": {
        "subject": "steady flame composition and motion",
        "expectedCondition": "readable hot core; subordinate outer body; smoke does not obscure the core; detached embers do not move as one parent card; no visible loop seam or long-term drift",
        "evidenceLocation": {"state": "steady", "frameInterval": [21, 291], "roi": "effect bounding region in Beauty filmstrip"}
      }
    },
    {
      "designRequirementId": "REQ-VISUAL-EXITS",
      "type": "visual-semantic",
      "evidenceAuthority": "visualQa",
      "statement": "Graceful stop and interrupt are visually distinguishable, causally continuous exits and neither ends with an unexplained hard cut.",
      "visualVerdict": {
        "subject": "stop and interrupt transitions",
        "expectedCondition": "stop dissipates; interrupt releases a brief burst; both preserve the origin and clear by their deadlines",
        "evidenceLocation": {"state": "stopping and interrupted branches", "frameInterval": [0, 75], "roi": "effect bounding region in both exit filmstrips"}
      }
    },
    {
      "designRequirementId": "REQ-BUDGET-S0B",
      "type": "budget",
      "evidenceAuthority": "telemetry",
      "statement": "The Runtime Entry stays within 144 particle capacity, 7 particle renderers, 2 blend-state materials, 1 unshadowed light, and zero runtime texture residency."
    },
    {
      "designRequirementId": "REQ-USER-L4",
      "type": "user-signoff",
      "evidenceAuthority": "user",
      "statement": "Final dynamic visual quality and commercial suitability remain pending until the user signs this contract revision, build hash, and capture profile."
    }
