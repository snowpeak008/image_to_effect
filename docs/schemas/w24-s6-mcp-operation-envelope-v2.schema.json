{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w24-s6/mcp-operation-envelope-v2",
  "title": "W24 S6 structural operation envelope (not authority)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "projectIdentityHash", "executionMode", "requestedAuthority", "rollbackMode", "operations", "planHash"],
  "properties": {
    "schemaVersion": {"const": "w24-s6/mcp-operation-envelope-v2"},
    "requestId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
    "projectIdentityHash": {"$ref": "#/$defs/sha256"},
    "executionMode": {"const": "DryRun"},
    "requestedAuthority": {"enum": ["DryRun", "ReadOnly"]},
    "rollbackMode": {"const": "NoWriteRequired"},
    "approvalToken": {"type": "string", "maxLength": 0},
    "operations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/operation"}},
    "planHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "kind", "targetPath", "expectedInputHash"],
      "properties": {
        "operationId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
        "kind": {"enum": ["ParseRecipeSyntax", "ValidateContractDocument", "InspectManifestHeader"]},
        "targetPath": {"type": "string", "maxLength": 260, "pattern": "^[^\\\\:|\\u0000-\\u001f\\u007f]+$"},
        "expectedInputHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
