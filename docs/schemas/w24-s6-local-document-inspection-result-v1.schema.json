{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w24-s6/local-document-inspection-result-v1",
  "title": "W24 S6 non-authoritative in-memory document inspection result",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "authority", "machineGatePassed", "scope", "operationKind", "targetPath", "inputSha256", "inputBytes", "classification", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": "w24-s6/local-document-inspection-result-v1"},
    "authority": {"const": "none"},
    "machineGatePassed": {"const": false},
    "scope": {"const": "syntax-and-document-inspection-only"},
    "operationKind": {"type": ["string", "null"], "enum": ["ParseRecipeSyntax", "ValidateContractDocument", "InspectManifestHeader", null]},
    "targetPath": {"type": ["string", "null"], "maxLength": 260},
    "inputSha256": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "inputBytes": {"type": "integer", "minimum": 0},
    "classification": {"enum": ["document-valid", "document-invalid", "rejected"]},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "field", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "field": {"type": "string"}, "message": {"type": "string", "minLength": 1}}}
  }
}
