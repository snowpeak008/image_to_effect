{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vfxcomposer.dev/desktop/vfxcomposer-status-provenance-v1.schema.json",
  "title": "VFX Composer status provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "statusDomain",
    "sourceKind",
    "sourceIdentity",
    "observedAtUtc"
  ],
  "properties": {
    "protocolVersion": {
      "const": "vfxcomposer.protocol/1.0"
    },
    "statusDomain": {
      "enum": [
        "MACHINE",
        "VISUAL",
        "USER_VERDICT",
        "L3",
        "L4"
      ]
    },
    "sourceKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sourceIdentity": {
      "$ref": "#/$defs/typedHash"
    },
    "observedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?(?:Z|\\+00:00)$"
    }
  },
  "$defs": {
    "typedHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeTag",
        "digest"
      ],
      "properties": {
        "typeTag": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9._-]*/[a-z0-9._-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
