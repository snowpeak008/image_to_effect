{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vfxcomposer.dev/desktop/vfxcomposer-read-document-query-v1.schema.json",
  "title": "VFX Composer registered project document read query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageKind",
    "requestId",
    "leaseId",
    "projectIdentity",
    "leaseGeneration",
    "documentKind",
    "documentId",
    "expectedContentHash"
  ],
  "properties": {
    "protocolVersion": { "const": "vfxcomposer.protocol/1.0" },
    "messageKind": { "const": "project.document.read.query" },
    "requestId": { "$ref": "#/$defs/token" },
    "leaseId": { "$ref": "#/$defs/token" },
    "projectIdentity": { "$ref": "#/$defs/projectIdentity" },
    "leaseGeneration": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "documentKind": { "enum": ["LIBRARY_INDEX", "MANIFEST", "CONTRACT", "TRACE"] },
    "documentId": { "$ref": "#/$defs/documentId" },
    "expectedContentHash": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/contentHash" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "documentKind": { "const": "LIBRARY_INDEX" } },
        "required": ["documentKind"]
      },
      "then": {
        "properties": { "documentId": { "const": "project" } }
      },
      "else": {
        "properties": { "documentId": { "$ref": "#/$defs/documentId" } }
      }
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeTag", "digest"],
      "properties": {
        "typeTag": { "const": "vfxcomposer.project-identity/1" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeTag", "digest"],
      "properties": {
        "typeTag": { "const": "vfxcomposer.document-content/1" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
