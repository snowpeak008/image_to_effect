{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vfxcomposer.dev/desktop/vfxcomposer-read-document-result-v1.schema.json",
  "title": "VFX Composer registered project document read result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageKind",
    "requestId",
    "accepted",
    "projectIdentity",
    "documentKind",
    "documentId",
    "contentHash",
    "byteLength",
    "contentBase64",
    "diagnostic"
  ],
  "properties": {
    "protocolVersion": { "const": "vfxcomposer.protocol/1.0" },
    "messageKind": { "const": "project.document.read.result" },
    "requestId": { "$ref": "#/$defs/token" },
    "accepted": { "type": "boolean" },
    "projectIdentity": { "$ref": "#/$defs/projectIdentity" },
    "documentKind": { "enum": ["LIBRARY_INDEX", "MANIFEST", "CONTRACT", "TRACE"] },
    "documentId": { "$ref": "#/$defs/documentId" },
    "contentHash": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/contentHash" }
      ]
    },
    "byteLength": { "type": "integer", "minimum": 0, "maximum": 524288 },
    "contentBase64": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "maxLength": 699052,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      ]
    },
    "diagnostic": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "vfxcomposer-diagnostic-v1.schema.json" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "documentKind": { "const": "LIBRARY_INDEX" } },
        "required": ["documentKind"]
      },
      "then": {
        "properties": { "documentId": { "const": "project" } }
      },
      "else": {
        "properties": { "documentId": { "$ref": "#/$defs/documentId" } }
      }
    },
    {
      "if": {
        "properties": { "accepted": { "const": true } },
        "required": ["accepted"]
      },
      "then": {
        "properties": {
          "contentHash": { "$ref": "#/$defs/contentHash" },
          "contentBase64": { "type": "string" },
          "diagnostic": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "contentHash": { "type": "null" },
          "byteLength": { "const": 0 },
          "contentBase64": { "type": "null" },
          "diagnostic": { "$ref": "vfxcomposer-diagnostic-v1.schema.json" }
        }
      }
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeTag", "digest"],
      "properties": {
        "typeTag": { "const": "vfxcomposer.project-identity/1" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeTag", "digest"],
      "properties": {
        "typeTag": { "const": "vfxcomposer.document-content/1" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
