{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vfxcomposer.dev/desktop/jobs/vfxcomposer-job-artifact-v1.schema.json",
  "title": "jobs/vfxcomposer-job-artifact-v1.schema.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "vfxcomposer.protocol/1.0"
    },
    "messageKind": {
      "const": "job.artifact"
    },
    "projectIdentity": {
      "type": "object",
      "properties": {
        "typeTag": {
          "const": "vfxcomposer.project-identity/1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "typeTag",
        "digest"
      ],
      "additionalProperties": false
    },
    "leaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "maxLength": 128
    },
    "leaseGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "job": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "maxLength": 128
        },
        "originRequestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "maxLength": 128
        },
        "originCommandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "maxLength": 128
        },
        "originIdempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "maxLength": 128
        },
        "originCommandKind": {
          "enum": [
            "command.validate-recipe",
            "command.build-candidate",
            "command.open-preview-job",
            "command.close-preview-job",
            "command.set-preview-playback",
            "command.validate-patch",
            "command.apply-patch",
            "command.run-focused-tests",
            "command.cancel-job"
          ]
        },
        "originCommandSelfHash": {
          "type": "object",
          "properties": {
            "typeTag": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*/[a-z0-9._-]+$",
              "maxLength": 96
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "typeTag",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jobId",
        "originRequestId",
        "originCommandId",
        "originIdempotencyKey",
        "originCommandKind",
        "originCommandSelfHash"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "originCommandKind": {
              "const": "command.validate-recipe"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.validate-recipe/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.build-candidate"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.build-candidate/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.open-preview-job"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.open-preview-job/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.close-preview-job"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.close-preview-job/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.set-preview-playback"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.set-preview-playback/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.validate-patch"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.validate-patch/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.apply-patch"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.apply-patch/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.run-focused-tests"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.run-focused-tests/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        },
        {
          "properties": {
            "originCommandKind": {
              "const": "command.cancel-job"
            },
            "originCommandSelfHash": {
              "type": "object",
              "properties": {
                "typeTag": {
                  "const": "vfxcomposer.command.cancel-job/1"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "typeTag",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "originCommandKind",
            "originCommandSelfHash"
          ]
        }
      ]
    },
    "eventSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "artifactKind": {
      "enum": [
        "CANDIDATE_IDENTITY",
        "PREVIEW_IDENTITY",
        "PATCH_VALIDATION",
        "FOCUSED_TEST_REPORT"
      ]
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "maxLength": 128
    },
    "artifactHash": {
      "type": "object",
      "properties": {
        "typeTag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*/[a-z0-9._-]+$",
          "maxLength": 96
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "typeTag",
        "digest"
      ],
      "additionalProperties": false
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "selfHash": {
      "type": "object",
      "properties": {
        "typeTag": {
          "const": "vfxcomposer.job-artifact/1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "typeTag",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "messageKind",
    "projectIdentity",
    "leaseId",
    "leaseGeneration",
    "job",
    "eventSequence",
    "artifactKind",
    "artifactId",
    "artifactHash",
    "byteLength",
    "selfHash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "artifactKind": {
            "const": "CANDIDATE_IDENTITY"
          }
        },
        "required": [
          "artifactKind"
        ]
      },
      "then": {
        "properties": {
          "artifactHash": {
            "type": "object",
            "properties": {
              "typeTag": {
                "const": "vfxcomposer.candidate-identity/1"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "typeTag",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactKind": {
            "const": "PREVIEW_IDENTITY"
          }
        },
        "required": [
          "artifactKind"
        ]
      },
      "then": {
        "properties": {
          "artifactHash": {
            "type": "object",
            "properties": {
              "typeTag": {
                "const": "vfxcomposer.preview-identity/1"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "typeTag",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactKind": {
            "const": "PATCH_VALIDATION"
          }
        },
        "required": [
          "artifactKind"
        ]
      },
      "then": {
        "properties": {
          "artifactHash": {
            "type": "object",
            "properties": {
              "typeTag": {
                "const": "vfxcomposer.patch-validation/1"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "typeTag",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactKind": {
            "const": "FOCUSED_TEST_REPORT"
          }
        },
        "required": [
          "artifactKind"
        ]
      },
      "then": {
        "properties": {
          "artifactHash": {
            "type": "object",
            "properties": {
              "typeTag": {
                "const": "vfxcomposer.focused-test-report/1"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "typeTag",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
