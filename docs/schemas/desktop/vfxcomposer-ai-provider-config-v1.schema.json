{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vfxcomposer.dev/desktop/vfxcomposer-ai-provider-config-v1.schema.json",
  "title": "VFX Composer AI provider configuration v1",
  "description": "Non-secret current-user AI provider configuration. Secret payloads are never JSON fields; only secretRef is permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "revision",
    "profiles",
    "channelBindings"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "profiles": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/profile" }
    },
    "channelBindings": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/channelBinding" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "origin",
        "enabled",
        "protocol",
        "endpoint",
        "auth",
        "timeoutSeconds",
        "capabilities"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "origin": { "enum": ["Official", "Relay", "Friend", "Subscription", "Custom"] },
        "enabled": { "type": "boolean" },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-z][a-z0-9.-]*-v1$" }
          }
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "allowLoopbackHttp"],
          "properties": {
            "uri": { "type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https?://[^?#]+$" },
            "allowLoopbackHttp": { "type": "boolean" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretRef", "secretScope"],
          "properties": {
            "secretRef": { "$ref": "#/$defs/identifier" },
            "secretScope": { "enum": ["Production", "DevelopmentOnly"] }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "modelId"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "channel": { "enum": ["ChatLlm", "ImageGeneration"] },
        "modelId": { "$ref": "#/$defs/modelId" }
      }
    },
    "channelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "profileId", "capabilityId", "modelId"],
      "properties": {
        "channel": { "enum": ["ChatLlm", "ImageGeneration"] },
        "profileId": { "$ref": "#/$defs/identifier" },
        "capabilityId": { "$ref": "#/$defs/identifier" },
        "modelId": { "$ref": "#/$defs/modelId" }
      }
    }
  }
}
