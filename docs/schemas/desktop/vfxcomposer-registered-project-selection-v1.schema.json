{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vfxcomposer.dev/desktop/vfxcomposer-registered-project-selection-v1.schema.json",
  "title": "VFX Composer registered project selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageKind",
    "requestId",
    "registeredProjectId",
    "projectIdentity",
    "brokerGeneration",
    "registrationGeneration"
  ],
  "properties": {
    "protocolVersion": { "const": "vfxcomposer.protocol/1.0" },
    "messageKind": { "const": "project.registered.selection" },
    "requestId": { "$ref": "#/$defs/token" },
    "registeredProjectId": { "$ref": "#/$defs/token" },
    "projectIdentity": { "$ref": "#/$defs/projectIdentity" },
    "brokerGeneration": { "$ref": "#/$defs/positiveGeneration" },
    "registrationGeneration": { "$ref": "#/$defs/positiveGeneration" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "positiveGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeTag", "digest"],
      "properties": {
        "typeTag": { "const": "vfxcomposer.project-identity/1" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
