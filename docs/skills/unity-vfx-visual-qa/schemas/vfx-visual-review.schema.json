{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-to-smart.local/schemas/vfx-visual-review/v1",
  "title": "VFX_VISUAL_REVIEW",
  "description": "Sealed independent Visual QA report. sealedReportHash is SHA-256 of canonical UTF-8 JSON with sealedReportHash omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewVersion", "candidateId", "contractHash", "buildHash", "captureProfileHash", "evidenceHashes", "imageInputRead", "evidenceStatus", "contractStatus", "s0aTerminalStatus", "qaGateAuthority", "topLevelRoute", "perRequirement", "sealedReportHash"],
  "properties": {
    "reviewVersion": {"type": "string", "minLength": 1},
    "candidateId": {"type": "string", "pattern": "^C[0-2]$"},
    "contractHash": {"$ref": "#/$defs/hash"},
    "buildHash": {"$ref": "#/$defs/hash"},
    "captureProfileHash": {"$ref": "#/$defs/hash"},
    "evidenceHashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "imageInputRead": {"type": "boolean"},
    "evidenceStatus": {"enum": ["valid", "invalid"]},
    "contractStatus": {"enum": ["unambiguous", "ambiguous"]},
    "s0aTerminalStatus": {"type": ["string", "null"], "enum": ["S0A_GATE_QUALIFIED", "S0A_ADVISORY_ONLY", null]},
    "qaGateAuthority": {"enum": ["ordinary-l3-gate", "advisory-only"]},
    "topLevelRoute": {"enum": ["VISUAL_PASS", "VISUAL_FAIL", "EVIDENCE_INVALID", "CONTRACT_AMBIGUOUS", "VISUAL_UNCERTAIN"]},
    "perRequirement": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirementReview"}},
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sealedReportHash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"s0aTerminalStatus": {"const": "S0A_GATE_QUALIFIED"}}, "required": ["s0aTerminalStatus"]},
      "then": {"properties": {"qaGateAuthority": {"const": "ordinary-l3-gate"}}}
    },
    {
      "if": {"properties": {"s0aTerminalStatus": {"enum": ["S0A_ADVISORY_ONLY", null]}}, "required": ["s0aTerminalStatus"]},
      "then": {"properties": {"qaGateAuthority": {"const": "advisory-only"}}}
    },
    {
      "if": {"properties": {"topLevelRoute": {"const": "VISUAL_PASS"}}, "required": ["topLevelRoute"]},
      "then": {
        "properties": {
          "imageInputRead": {"const": true},
          "evidenceStatus": {"const": "valid"},
          "contractStatus": {"const": "unambiguous"},
          "perRequirement": {"items": {"properties": {"state": {"const": "pass"}, "countable": {"const": true}, "reasonCode": {"const": "OBSERVED"}}, "required": ["state", "countable", "reasonCode"]}}
        }
      }
    },
    {
      "if": {"properties": {"topLevelRoute": {"const": "VISUAL_FAIL"}}, "required": ["topLevelRoute"]},
      "then": {
        "properties": {
          "imageInputRead": {"const": true},
          "evidenceStatus": {"const": "valid"},
          "contractStatus": {"const": "unambiguous"},
          "perRequirement": {"contains": {"properties": {"state": {"const": "fail"}, "countable": {"const": true}, "reasonCode": {"const": "OBSERVED"}}, "required": ["state", "countable", "reasonCode"]}}
        }
      }
    },
    {
      "if": {"properties": {"topLevelRoute": {"const": "VISUAL_UNCERTAIN"}}, "required": ["topLevelRoute"]},
      "then": {
        "properties": {
          "imageInputRead": {"const": true},
          "evidenceStatus": {"const": "valid"},
          "contractStatus": {"const": "unambiguous"},
          "perRequirement": {"allOf": [{"contains": {"properties": {"state": {"const": "uncertain"}, "countable": {"const": true}, "reasonCode": {"const": "VISUAL_UNCERTAIN"}}, "required": ["state", "countable", "reasonCode"]}}, {"not": {"contains": {"properties": {"state": {"const": "fail"}}, "required": ["state"]}}}]}
        }
      }
    },
    {
      "if": {"properties": {"topLevelRoute": {"const": "EVIDENCE_INVALID"}}, "required": ["topLevelRoute"]},
      "then": {
        "properties": {
          "evidenceStatus": {"const": "invalid"},
          "perRequirement": {"items": {"properties": {"state": {"const": "uncertain"}, "countable": {"const": false}, "reasonCode": {"const": "EVIDENCE_INVALID"}}, "required": ["state", "countable", "reasonCode"]}}
        }
      }
    },
    {
      "if": {"properties": {"topLevelRoute": {"const": "CONTRACT_AMBIGUOUS"}}, "required": ["topLevelRoute"]},
      "then": {
        "properties": {
          "evidenceStatus": {"const": "valid"},
          "contractStatus": {"const": "ambiguous"},
          "perRequirement": {"items": {"properties": {"state": {"const": "uncertain"}, "countable": {"const": false}, "reasonCode": {"const": "CONTRACT_AMBIGUOUS"}}, "required": ["state", "countable", "reasonCode"]}}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "requirementReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designRequirementId", "state", "countable", "reasonCode", "stateRef", "frameNumbers", "imageRegion", "observation"],
      "properties": {
        "designRequirementId": {"type": "string", "minLength": 1},
        "state": {"enum": ["pass", "fail", "uncertain"]},
        "countable": {"type": "boolean"},
        "reasonCode": {"enum": ["OBSERVED", "EVIDENCE_INVALID", "CONTRACT_AMBIGUOUS", "VISUAL_UNCERTAIN"]},
        "stateRef": {"type": "string", "minLength": 1},
        "frameNumbers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "imageRegion": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1}
      }
    }
  }
}
