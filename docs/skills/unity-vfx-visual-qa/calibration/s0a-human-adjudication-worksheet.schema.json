{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-to-smart.local/schemas/s0a-human-adjudication-worksheet/v1",
  "title": "Unreviewed S0a human adjudication worksheet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "holdoutCohort", "reviewStatus", "blindManifestHash", "reviewContractHash", "rows", "worksheetHash"],
  "properties": {
    "schemaVersion": {"const": "s0a-human-adjudication-worksheet/v1"},
    "holdoutCohort": {"enum": ["reduced-36-12-12-6", "full-60-20-20-10"]},
    "reviewStatus": {"const": "UNREVIEWED"},
    "blindManifestHash": {"$ref": "#/$defs/hash"},
    "reviewContractHash": {"$ref": "#/$defs/hash"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
    "worksheetHash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"holdoutCohort": {"const": "reduced-36-12-12-6"}}, "required": ["holdoutCohort"]},
      "then": {"properties": {"rows": {"minItems": 66, "maxItems": 66}}},
      "else": {"properties": {"rows": {"minItems": 110, "maxItems": 110}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sampleId": {"type": "string", "pattern": "^s0a-[a-f0-9]{20}$"},
    "requirementId": {"type": "string", "pattern": "^s0a\\.visual\\.req\\.[a-f0-9]{20}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleId", "designRequirementIds", "evidenceHash", "groundTruthRoute", "perRequirement", "visuallyObservable", "eligibleForVisualMetrics", "reviewer", "adjudicationNotes"],
      "properties": {
        "sampleId": {"$ref": "#/$defs/sampleId"},
        "designRequirementIds": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/requirementId"}},
        "evidenceHash": {"$ref": "#/$defs/hash"},
        "groundTruthRoute": {"const": null},
        "perRequirement": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["designRequirementId", "state"], "properties": {"designRequirementId": {"$ref": "#/$defs/requirementId"}, "state": {"const": null}}}},
        "visuallyObservable": {"const": null},
        "eligibleForVisualMetrics": {"const": null},
        "reviewer": {"const": null},
        "adjudicationNotes": {"const": ""}
      }
    }
  }
}
