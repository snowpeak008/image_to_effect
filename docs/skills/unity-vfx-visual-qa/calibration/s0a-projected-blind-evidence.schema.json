{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-to-smart.local/schemas/s0a-projected-blind-evidence/v1",
  "title": "Projected S0a blind evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sampleId", "designRequirementIds", "reviewContractHash", "captureProfilePolicyHash", "captureProfileInstanceHash", "frameTableHash", "sourceIdentity", "captureMetadata", "frames", "evidenceHash"],
  "properties": {
    "schemaVersion": {"const": "s0a-projected-blind-evidence/v1"},
    "sampleId": {"$ref": "#/$defs/sampleId"},
    "designRequirementIds": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requirementId"}},
    "reviewContractHash": {"$ref": "#/$defs/hash"},
    "captureProfilePolicyHash": {"$ref": "#/$defs/hash"},
    "captureProfileInstanceHash": {"$ref": "#/$defs/hash"},
    "frameTableHash": {"$ref": "#/$defs/hash"},
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneHash", "prefabManifestHash", "buildHash", "captureToolHash"],
      "properties": {
        "sceneHash": {"$ref": "#/$defs/hash"},
        "prefabManifestHash": {"$ref": "#/$defs/hash"},
        "buildHash": {"$ref": "#/$defs/hash"},
        "captureToolHash": {"$ref": "#/$defs/hash"}
      }
    },
    "captureMetadata": {"$ref": "#/$defs/integrityPair"},
    "frames": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/frame"}},
    "evidenceHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "sampleId": {"type": "string", "pattern": "^s0a-[a-f0-9]{20}$"},
    "requirementId": {"type": "string", "pattern": "^s0a\\.visual\\.req\\.[a-f0-9]{20}$"},
    "integrityPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredHash", "actualHash"],
      "properties": {"declaredHash": {"$ref": "#/$defs/hash"}, "actualHash": {"$ref": "#/$defs/hash"}}
    },
    "beauty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "file", "declaredHash", "actualHash"],
      "properties": {
        "availability": {"enum": ["present", "missing"]},
        "file": {"type": ["string", "null"]},
        "declaredHash": {"$ref": "#/$defs/hash"},
        "actualHash": {"$ref": "#/$defs/nullableHash"}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "present"}}, "required": ["availability"]}, "then": {"properties": {"file": {"type": "string", "minLength": 1}, "actualHash": {"$ref": "#/$defs/hash"}}}},
        {"if": {"properties": {"availability": {"const": "missing"}}, "required": ["availability"]}, "then": {"properties": {"file": {"const": null}, "actualHash": {"const": null}}}}
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedOrdinal", "frameIndex", "stateRef", "beauty"],
      "properties": {
        "seedOrdinal": {"type": "integer", "minimum": 0, "maximum": 2},
        "frameIndex": {"enum": [1, 21, 60, 120, 180, 240, 300, 360]},
        "stateRef": {"type": "string", "minLength": 1},
        "beauty": {"$ref": "#/$defs/beauty"}
      }
    }
  }
}
