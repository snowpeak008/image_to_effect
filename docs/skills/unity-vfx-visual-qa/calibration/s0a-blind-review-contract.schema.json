{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-to-smart.local/schemas/s0a-no-answer-review-contract/v1",
  "title": "No-answer S0a blind review contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "holdoutCohort", "effectId", "answerDisclosure", "reviewInstructions", "frameTable", "assignments", "contractHash"],
  "properties": {
    "schemaVersion": {"const": "s0a-no-answer-review-contract/v1"},
    "holdoutCohort": {"enum": ["reduced-36-12-12-6", "full-60-20-20-10"]},
    "effectId": {"const": "sustained_flame_3d"},
    "answerDisclosure": {"const": "NONE"},
    "reviewInstructions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "frameTable": {"$ref": "#/$defs/frameTable"},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sampleId", "designRequirementIds", "criterion"],
        "properties": {
          "sampleId": {"$ref": "#/$defs/sampleId"},
          "designRequirementIds": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requirementId"}},
          "criterion": {"type": "string", "minLength": 1}
        }
      }
    },
    "contractHash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"holdoutCohort": {"const": "reduced-36-12-12-6"}}, "required": ["holdoutCohort"]},
      "then": {"properties": {"assignments": {"minItems": 66, "maxItems": 66}}},
      "else": {"properties": {"assignments": {"minItems": 110, "maxItems": 110}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sampleId": {"type": "string", "pattern": "^s0a-[a-f0-9]{20}$"},
    "requirementId": {"type": "string", "pattern": "^s0a\\.visual\\.req\\.[a-f0-9]{20}$"},
    "frameTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retainedFrameIndices", "seedRows"],
      "properties": {
        "retainedFrameIndices": {"const": [1, 21, 60, 120, 180, 240, 300, 360]},
        "seedRows": {"const": ["canonical", "robustness-1", "robustness-2"]}
      }
    }
  }
}
