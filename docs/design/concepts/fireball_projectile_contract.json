      "evidenceAuthority": "diagnostic",
      "statement": "离散火星 6~14 颗可见，单颗亮度进入最亮两档（顶亮），总数不淹没构图（克制纪律）。",
      "visualVerdict": {
        "subject": "sparks",
        "expectedCondition": "6-14 visible motes, each in top-2 brightness steps",
        "evidenceLocation": {
          "state": "travel",
          "frameInterval": [
            55,
            65
          ],
          "roi": "full frame"
