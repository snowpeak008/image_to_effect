  "requirements": [
    {
      "designRequirementId": "fb.head.whitehot",
      "type": "visual-measurable",
      "evidenceAuthority": "diagnostic",
      "statement": "travel 稳态帧中头部核心为画面最亮区域，线性亮度达 HDR（>1.0），Bloom-off 帧中心 ROI 平均亮度 ≥ 焰体中段 ROI 的 2.5 倍。",
      "visualVerdict": {
        "subject": "head_core",
        "expectedCondition": "brightest region; >=2.5x mid-body luminance in bloom-off frame",
        "evidenceLocation": {
          "state": "travel",
          "frameInterval": [
            55,
            65
          ],
          "roi": "head circle r=12% at head anchor"
        }
      }
    },
    {
      "designRequirementId": "fb.body.emissive",
      "type": "visual-measurable",
      "evidenceAuthority": "diagnostic",
      "statement": "焰体头/中段为加法发光：bloom-on 帧焰体边缘外侧 4px 环带亮度显著高于背景底噪（发光渗出），且中段档内存在连续亮度梯度（非纯平色块）。",
      "visualVerdict": {
        "subject": "flame_body",
        "expectedCondition": "additive bleed beyond silhouette; in-band gradient stddev > flat-band epsilon",
        "evidenceLocation": {
          "state": "travel",
          "frameInterval": [
            55,
            65
          ],
          "roi": "mid-body band x∈[35%,60%]"
        }
      }
    },
    {
      "designRequirementId": "fb.body.fourstep",
      "type": "visual-semantic",
      "evidenceAuthority": "visualQa",
      "statement": "焰体沿运动轴呈四级可辨色带：白热核/亮橙/橙红/深红尾（认可稿色阶），尾段深红可读不发黑不偏橙（userDecision tail_color=hybrid）。",
      "visualVerdict": {
        "subject": "flame_body",
        "expectedCondition": "four distinguishable brightness/hue steps head-to-tail; tail step reads deep red",
        "evidenceLocation": {
          "state": "travel",
          "frameInterval": [
            55,
            65
          ],
          "roi": "full wake band"
        }
      }
    },
    {
      "designRequirementId": "fb.body.ribbons",
      "type": "visual-semantic",
      "evidenceAuthority": "visualQa",
      "statement": "焰体后 1/3 撕裂为多条细丝带（认可稿的焰海尾梢），丝带与主体连续（无断裂空档），前 1/3 保持致密连接头部。",
      "visualVerdict": {
        "subject": "flame_body",
        "expectedCondition": "tail third resolves into >=4 thin continuous ribbons; front third solid and connected to head",
        "evidenceLocation": {
          "state": "travel",
          "frameInterval": [
            55,
            65
          ],
          "roi": "tail band x∈[0%,35%]"
        }
      }
    },
    {
      "designRequirementId": "fb.smoke.weight",
      "type": "visual-semantic",
      "evidenceAuthority": "visualQa",
      "statement": "深红烟幕衬底明显可见，宽于焰体主体、亮度低于焰体最暗档，位于尾流下后方（userDecision smoke_weight=per-sheet：构图的一半体量）。",
      "visualVerdict": {
        "subject": "smoke_veil",
        "expectedCondition": "clearly visible deep-red mass wider than flame body, darker than dimmest flame step",
        "evidenceLocation": {
          "state": "travel",
          "frameInterval": [
            55,
            65
          ],
          "roi": "lower/rear half of wake extent"
        }
      }
    },
    {
